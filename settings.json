  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/yuvrajsingh/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking GitNexus index freshness..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3.14 -m ctx.adapters.claude_code.hooks.context_monitor --from-stdin"
          },
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3.14 -m skill_add_detector --from-stdin"
          },
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3.14 -m ctx.adapters.claude_code.hooks.bundle_orchestrator"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3.14 -m ctx.adapters.claude_code.hooks.lifecycle_hooks backup-on-change"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/lean-ctx hook observe"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/lean-ctx hook read-dedup"
          }
        ]
      }
    ],
    "PreCompact": [
